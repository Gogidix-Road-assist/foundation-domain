# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dashboard_aggregation
MONGODB_DB_NAME=dashboard_aggregation

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# External Services Configuration
API_GATEWAY_URL=http://localhost:8080
BILLING_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
GEOLOCATION_SERVICE_URL=http://localhost:8083
AI_LEADS_SERVICE_URL=http://localhost:8084
CONFIG_SERVICE_URL=http://localhost:8085

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Dashboard Configuration
DASHBOARD_CACHE_TTL=300
METRICS_AGGREGATION_INTERVAL=60000
REAL_TIME_UPDATES_ENABLED=true
WEBSOCKET_ENABLED=true

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
SERVICE_HEALTH_CHECK_INTERVAL=30000