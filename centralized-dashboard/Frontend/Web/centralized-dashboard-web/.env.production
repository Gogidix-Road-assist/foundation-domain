# Production Environment Variables for AI Services Dashboard
# Version: 1.0.0
# Deployment: Vercel

# =====================================================
# API Configuration
# =====================================================
VITE_API_BASE_URL=https://rapid-assist-foundation.railway.app
VITE_API_URL=https://rapid-assist-foundation.railway.app/api
VITE_WS_URL=wss://rapid-assist-foundation.railway.app

# =====================================================
# Supabase Configuration
# =====================================================
# Replace with actual Supabase project values
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# =====================================================
# AI Service Endpoints (Railway)
# =====================================================
VITE_AI_CHATBOT_SERVICE=https://ai-chatbot-service-production.railway.app
VITE_AI_SENTIMENT_SERVICE=https://ai-sentiment-analysis-service-production.railway.app
VITE_AI_TRANSLATION_SERVICE=https://ai-translation-service-production.railway.app
VITE_AI_IMAGE_RECOGNITION_SERVICE=https://ai-image-recognition-service-production.railway.app
VITE_AI_CONTENT_GENERATOR_SERVICE=https://ai-content-generator-service-production.railway.app
VITE_AI_DATA_PREDICTION_SERVICE=https://ai-data-prediction-service-production.railway.app
VITE_AI_LEADS_GENERATOR_SERVICE=https://ai-leads-generator-service-production.railway.app
VITE_AI_RECOMMENDATION_ENGINE_SERVICE=https://ai-recommendation-engine-service-production.railway.app
VITE_AI_TEXT_SUMMARIZATION_SERVICE=https://ai-text-summarization-service-production.railway.app
VITE_AI_SPEECH_RECOGNITION_SERVICE=https://ai-speech-recognition-service-production.railway.app
VITE_AI_VOICE_ASSISTANT_SERVICE=https://ai-voice-assistant-service-production.railway.app
VITE_AI_DOCUMENT_ANALYZER_SERVICE=https://ai-document-analyzer-service-production.railway.app
VITE_AI_ANOMALY_DETECTION_SERVICE=https://ai-anomaly-detection-service-production.railway.app
VITE_AI_TRAINING_ML_SERVICE=https://ai-training-ml-service-production.railway.app

# =====================================================
# Analytics Service Endpoints
# =====================================================
VITE_ANALYTICS_SERVICE=https://analytics-service-production.railway.app
VITE_DATA_ANALYTICS_SERVICE=https://data-analytics-service-production.railway.app
VITE_CUSTOMER_BEHAVIOUR_ANALYTICS_SERVICE=https://customer-behaviour-analytics-service-production.railway.app

# =====================================================
# Other Service Endpoints
# =====================================================
VITE_FRAUD_DETECTION_SERVICE=https://fraud-detection-service-production.railway.app
VITE_PREDICTIVE_MAINTENANCE_SERVICE=https://predictive-maintenance-service-production.railway.app
VITE_INTELLIGENT_DISPATCH_SERVICE=https://intelligent-dispatch-service-production.railway.app
VITE_ROUTE_OPTIMIZATION_SERVICE=https://route-optimization-service-production.railway.app
VITE_RECOMMENDATION_ENGINE_SERVICE=https://recommendation-engine-service-production.railway.app
VITE_CUSTOMER_SUPPORT_CHATBOT_SERVICE=https://customer-support-chatbot-service-production.railway.app
VITE_DOCUMENT_INTELLIGENCE_SERVICE=https://document-intelligence-service-production.railway.app
VITE_DYNAMIC_PRICING_SERVICE=https://dynamic-pricing-service-production.railway.app
VITE_VENDOR_PRODUCT_LISTING_SERVICE=https://vendors-product-listing-ai-service-production.railway.app
VITE_SENTIMENT_ANALYSIS_SERVICE=https://sentiment-analysis-service-production.railway.app

# =====================================================
# Feature Flags
# =====================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# =====================================================
# Application Settings
# =====================================================
VITE_APP_NAME=Rapid Assist AI Services Dashboard
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production
VITE_LOG_LEVEL=warn
VITE_REQUEST_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# =====================================================
# Security Settings
# =====================================================
VITE_ENABLE_HTTPS=true
VITE_API_KEY_HEADER=X-API-Key
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_MAX_REQUESTS=100
VITE_RATE_LIMIT_WINDOW_MS=60000

# =====================================================
# Monitoring & Observability
# =====================================================
VITE_SENTRY_DSN=
VITE_ENABLE_SENTRY=false
VITE_GA_TRACKING_ID=
VITE_ENABLE_GA=false
