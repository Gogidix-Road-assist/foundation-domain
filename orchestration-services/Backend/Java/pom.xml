    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Gogidix-Road-assist/foundation-domain</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>monitoring-service</module>
    </modules>
</project>
